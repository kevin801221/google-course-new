# 複製成 hotel_service/.env（.env 不要進版控）

# ── 路線 A：Developer API（AI Studio key，本 Lab 走這條）──
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY="AIza..."

# 步驟 5：讓 search_hotels 睡 6 秒，觀察 task 停在 WORKING
# HOTEL_SLOW_SECONDS=6

# 名片改成宣告 capabilities.streaming=true（to_a2a 自動生的名片是 false）
# A2A_STREAMING=1

# 寫進名片的 port，必須與 uvicorn --port 一致
# A2A_PORT=8001
