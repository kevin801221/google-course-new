        "state": {}
      },
      "conversation": [
        {
          "invocation_id": "c1-i1",
          "user_content": {
            "role": "user",
            "parts": [{ "text": "預算 3 萬，11 月去東京三天，有哪些旅館可以住？" }]
          },
          "intermediate_data": {
            "tool_uses": [
              { "name": "set_budget", "args": { "total_twd": 30000 } },
              { "name": "booking_agent", "args": { "request": "東京住三晚，找預算內的旅館" } },
              { "name": "search_hotels", "args": { "city": "東京", "nights": 3, "max_price": 0 } }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [{ "text": "總預算 3 萬、三晚，每晚上限 10000 元。可選：上野膠囊旅館 2800/晚（共 8400）、淺草和風旅館 4200/晚（共 12600）、新宿商務飯店 6500/晚（共 19500）。銀座柏悅 18000/晚超出上限。" }]
          }
        }
      ]
    },
    {
