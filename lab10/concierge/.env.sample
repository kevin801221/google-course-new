# 複製成 concierge/.env（不要進 git）。
# 誰會讀它：本機 `uv run adk web`、以及 `adk deploy agent_engine`
#   （Agent Engine 沒有 --set-env-vars，adk 是把 agent 目錄的 .env 帶上去當環境變數）。
#   Cloud Run 那條路不讀它 —— deploy.sh 用 --set-env-vars 注入。

# ---- 本機 adk web 用這一組（推薦）------------------------------------------
# 私有 Cloud Run 服務在本機沒辦法自己換 ID token：使用者帳號的 ADC 不能簽
# 任意 audience 的 ID token，fetch_id_token 會噴
#   google.auth.exceptions.DefaultCredentialsError: Neither metadata server or
#   valid service account credentials are found.
# 正確姿勢是開兩條 proxy，讓 gcloud 幫你簽（auth.py 看到 localhost 就不帶 header）：
#   gcloud run services proxy mcp-tools --region us-central1 --port=3000 &
#   gcloud run services proxy toolbox   --region us-central1 --port=3001 &
MCP_URL=http://localhost:3000
TOOLBOX_URL=http://localhost:3001
A2A_URL=https://hotel-a2a-xxxxxxxx-uc.a.run.app   # 公開服務，直接連真網址

# ---- adk deploy agent_engine（步驟 ⑦）用這一組 -----------------------------
# 雲端跑的時候容器內沒有 proxy，要填真網址；網址從這裡拿：
#   gcloud run services describe mcp-tools --region us-central1 --format 'value(status.url)'
# MCP_URL=https://mcp-tools-xxxxxxxx-uc.a.run.app
# TOOLBOX_URL=https://toolbox-xxxxxxxx-uc.a.run.app

GOOGLE_CLOUD_PROJECT=agent-course-2026
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_ENTERPRISE=True

# 本機 adk web 測 session 落地時才需要（雲端由 Secret Manager 注入，不要寫在這裡）
# SESSION_DB_URL=postgresql+asyncpg://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
