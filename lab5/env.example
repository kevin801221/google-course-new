# 課程標準環境變數範本（投影片 p.242）。複製成 .env 或直接貼進 shell。
# .env 只放本機開發用的值；雲端一律走 Secret Manager。.env 不要 commit。

# --- Developer API 路線（M1-M4 用這條）---
GEMINI_API_KEY=              # AI Studio 金鑰 https://aistudio.google.com/apikey
GOOGLE_API_KEY=              # ADK 讀的同義變數，值同上

# --- Enterprise（Vertex）路線三件套（M7 起的部署 Lab 用這條）---
# 值只能是 True 或 1：SDK 只認 'true'/'1'（不分大小寫），寫 yes/on 會被當成沒設且不警告。
# 走 Developer 路線（M1-M4）時把下面這行註解掉，不然 SDK 會去找 ADC。
GOOGLE_GENAI_USE_ENTERPRISE=True
# GOOGLE_GENAI_USE_VERTEXAI=TRUE   # 2025 舊名，SDK 仍相容；兩個都設且值衝突會印警告
GOOGLE_CLOUD_PROJECT=agent-course-2026
GOOGLE_CLOUD_LOCATION=us-central1

# --- M8 ---
SUPABASE_ACCESS_TOKEN=

# --- 給 setup.sh / verify.sh / teardown.sh 用（不是 SDK 讀的）---
PROJECT_ID=agent-course-2026
BILLING_ACCOUNT=             # gcloud billing accounts list 查，格式 XXXXXX-XXXXXX-XXXXXX
REGION=us-central1
BUDGET_AMOUNT=25USD
SA_NAME=agent-sa
NOTIFY_EMAIL=
