# cp .env.example .env 之後填上自己的值。.env 給 adk web／python 用，
# Toolbox 不吃 .env —— 它只讀環境變數，所以 DB_PASSWORD 一定要 export。
GEMINI_API_KEY=你的 AI Studio key
# Supabase Dashboard -> Connect -> Session pooler（5432）
DB_PASSWORD=你的資料庫密碼
DB_URL_RAW=postgresql://postgres.abcd1234:密碼@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
ADK_SESSION_URI=postgresql+asyncpg://postgres.abcd1234:密碼@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
TOOLBOX_URL=http://127.0.0.1:5000
# 加分題 A：掛上 pgvector 語意搜尋
# LAB8_RAG=1
